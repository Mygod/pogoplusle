  <string name="settings_connection_priority">Verbindungspriorität</string>
  <string name="settings_connection_priority_message">Der originale Pokémon GO Plus und einige andere Zubehörteile verlangsamen ihre Bluetooth-Verbindung, um Akku zu sparen, wodurch sich Drehen und Fangen verzögern. PoGo+LE kann Android bitten, sie zu beschleunigen, und fragt erneut, sobald das Zubehör sie wieder verlangsamt. Jede Option legt fest, wie oft Smartphone und Zubehör kommunizieren; schnellere Optionen leeren den Akku des Zubehörs schneller. Die Zeiten sind Android-Standardwerte und können je nach Smartphone abweichen.</string>
  <string name="settings_connection_priority_default">Zubehör-Standard</string>
  <string name="settings_connection_priority_default_summary">Die Verbindung so lassen, wie das Zubehör sie einstellt. Gilt ab der nächsten Verbindung.</string>
  <string name="settings_connection_priority_low_power">Energiesparend</string>
  <string name="settings_connection_priority_low_power_summary">Alle 100–125 ms. Geringste Beschleunigung, geringster Akkuverbrauch.</string>
  <string name="settings_connection_priority_balanced">Ausgewogen</string>
  <string name="settings_connection_priority_balanced_summary">Alle 30–50 ms. Der Großteil der Beschleunigung bei mäßigem Akkuverbrauch.</string>
  <string name="settings_connection_priority_dck">Digitaler Autoschlüssel</string>
  <string name="settings_connection_priority_dck_summary">Alle 30 ms, die Android-Voreinstellung für Autoschlüssel. Reagiert schneller als Ausgewogen, bei höherem Akkuverbrauch.</string>
  <string name="settings_connection_priority_high">Hoch</string>
  <string name="settings_connection_priority_high_summary">Alle 11–15 ms. Schnellste Reaktion, höchster Akkuverbrauch.</string>
