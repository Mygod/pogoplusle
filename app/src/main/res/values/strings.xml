    <string name="app_name" tools:ignore="MissingTranslation">PoGo+LE</string>
    <string name="xposed_description">Pokemon GO Plus and Nintendo Switch Bluetooth compatibility hooks</string>
    <string name="bluetooth_pairing_service_label">PoGo+LE Bluetooth pairing assistant</string>
    <string name="bluetooth_pairing_service_description">Automagically skips pairing dialog when connecting
        Pokémon GO Plus</string>
    <string name="bluetooth_pairing_service_disclosure_title">Grant control to this app?</string>
    <string name="bluetooth_pairing_service_disclosure">This feature needs to use Android Accessibility\u200bService API
        to read and control notifications and screen for system Settings in order to click the buttons
        <i>Pair &amp; connect</i> in the notification and <i>Pair</i> in the pairing dialog for you when connecting your
        Pokémon GO Plus. No data is collected through this process except for crash logs.\n\nTo grant the permission,
        click <i>Agree</i>, then click on this app and turn on the main switch that says <i>Use PoGo+LE Bluetooth
            pairing assistant</i>.</string>
    <string name="bluetooth_pairing_service_disclosure_restricted_settings">If that switch is greyed out, enable
        restricted settings for this app first: long press the app icon, open <i>App info</i>, use the three-dot menu,
        and choose <i>Allow restricted settings</i>, then return here.</string>
